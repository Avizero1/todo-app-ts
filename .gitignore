# .gitignore — что НЕ попадает в репозиторий: зависимости, сборки, секреты, локальный мусор.

# Node / фронтенд
node_modules/
dist/
coverage/
.vite/

# Kotlin / Gradle
build/
.gradle/
out/
.kotlin/
*.jar
!gradle-wrapper.jar

# секреты: шаблоны *.example коммитим, реальные .env — нет
.env
.env.*
!.env.example

# логи и мусор системы и редакторов
*.log
*.iml
.idea/
.vscode/
.DS_Store
Thumbs.db

# служебные файлы ИИ и локальный мусор
AI-CONTEXT.md

# задание PDF — локально, в репозиторий не тащим
*.pdf

# папка обучения (practice) — не часть проекта
practice/
